generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String                 @id @default(uuid())
  email             String                 @unique
  password          String
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  isVerified        Boolean                @default(false)
  userName          String                 @unique
  verificationToken String?
  receivedMocks     MockInterviewRequest[] @relation("Recipient")
  requestedMocks    MockInterviewRequest[] @relation("Requester")
  notifications     Notification[]
  followedThreads   ThreadFollower[]
  answers           Answer[]
  questions         Question[]
  questionLikes     QuestionLike[]
  schedule          Schedule[]
  savedQuestions    Question[]             @relation("UserSavedQuestions")
  comments            Comment[]
  availability   Availability[]
  resetToken       String?

  @@map("user")
  Interview Interview[]
}

/// Represents a scheduled interview.
model Schedule {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  interviewType String   @map("interview_type")
  peerType      String   @map("peer_type")
  practiceLevel String   @map("practice_level")
  date          DateTime
  time          DateTime
  sessionId     String?  @map("session_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user          User     @relation(fields: [userId], references: [id])
  session       Session? @relation(fields: [sessionId], references: [id])

  @@map("schedule")
}

/// Represents a question posted by a user.
model Question {
  id           String         @id @default(uuid())
  title        String
  content      String

 

  userId       String         @map("user_id")

  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  answers      Answer[]
  user         User           @relation(fields: [userId], references: [id])
  likes        QuestionLike[]
  tags         QuestionTag[]
  savedByUsers User[]         @relation("UserSavedQuestions")

  @@map("question")
}

model Tag {
  id        String        @id @default(uuid())
  name      String        @unique
  questions QuestionTag[]

  @@map("tag")
}

model QuestionTag {
  questionId String
  tagId      String
  question   Question @relation(fields: [questionId], references: [id])
  tag        Tag      @relation(fields: [tagId], references: [id])

  @@id([questionId, tagId])
  @@map("question_tag")
}

model Answer {
  id         String   @id @default(uuid())
  content    String
  userId     String
  questionId String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  question   Question @relation(fields: [questionId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@map("answer")
}

model QuestionLike {
  userId     String
  questionId String
  createdAt  DateTime @default(now()) @map("created_at")
  question   Question @relation(fields: [questionId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@id([userId, questionId])
  @@map("question_like")
}

model Notification {
  id          Int        @id @default(autoincrement())
  userId      String
  message     String
  isRead      Boolean    @default(false)
  createdAt   DateTime   @default(now())
  interviewId String?
  link        String
  type        String
  interview   Interview? @relation(fields: [interviewId], references: [id])
  user        User       @relation(fields: [userId], references: [id])
  eventType    DateTime   @default(now())
}

model Interview {
  id           String     @id @default(cuid())
  userId       String
  candidateEmail String
  userEmail    String
createdAt      DateTime       @default(now())
  interviewDate DateTime
  confirmed    Boolean
  notifications Notification[]
   requesterId    String
  recipientId    String
  user         User       @relation(fields: [userId], references: [id])
  
}








model MockInterviewRequest {
  id          String   @id @default(uuid())
  requesterId String
  recipientId String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  recipient   User     @relation("Recipient", fields: [recipientId], references: [id])
  requester   User     @relation("Requester", fields: [requesterId], references: [id])
}

model EmailLog {
  id        String   @id @default(uuid())
  recipient String
  subject   String
  content   String
  sentAt    DateTime @default(now())
}

model Thread {
  id        String           @id @default(uuid())
  title     String
  content   String
  createdAt DateTime         @default(now())
  replies   Reply[]
  followers ThreadFollower[]
  comments  Comment[]
}


model Comment {
  id        String   @id @default(uuid())
  content   String
  thread    Thread   @relation(fields: [threadId], references: [id])
  threadId  String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  createdAt DateTime @default(now())
}

model Reply {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id])
}

model ThreadFollower {
  id       String @id @default(uuid())
  userId   String
  threadId String
  thread   Thread @relation(fields: [threadId], references: [id])
  user     User   @relation(fields: [userId], references: [id])
}
model Availability {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  focusArea       String   @map("focus_area")
  meetingPlatform String   @map("meeting_platform")
  meetingLink     String   @map("meeting_link")
  rolePreference  String   @map("role_preference")
  startTime       DateTime @map("start_time")
  endTime         DateTime @map("end_time")
  date            DateTime
  status          String?  @default("available")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id])

   @@map("availability")
}

model Session {
  id            String   @id @default(uuid())
  interviewType String      @map("interview_type")
  date          DateTime
  time          DateTime
  meetingLink   String    @map("meeting_link")
  users         Schedule[]

   @@map("session")
}
